<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#08090C">

    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="92dp" android:layout_marginTop="84dp" android:layout_marginEnd="28dp" android:layout_marginBottom="300dp"
        android:background="#101218" />

    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#08090C"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:id="@+id/splashLogo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_gravity="center"
            android:background="#E53935"
            android:gravity="center"
            android:text="K\nTV"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />
    </FrameLayout>

    <View android:layout_width="match_parent" android:layout_height="145dp" android:background="@drawable/top_gradient" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="78dp" android:gravity="center_vertical" android:paddingStart="30dp" android:paddingEnd="30dp">
        <TextView android:layout_width="58dp" android:layout_height="58dp" android:background="#E53935" android:gravity="center" android:text="K\nTV" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Khattak TV" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE TELEVISION" android:textColor="#969BA6" android:textSize="10sp" android:letterSpacing="0.12" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:background="#E53935" android:paddingStart="11dp" android:paddingTop="5dp" android:paddingEnd="11dp" android:paddingBottom="5dp" android:text="● LIVE" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="72dp" android:layout_height="match_parent" android:layout_marginTop="84dp" android:layout_marginBottom="104dp" android:background="#0D0F14" android:gravity="top|center_horizontal" android:orientation="vertical" android:paddingTop="18dp">
        <TextView android:layout_width="56dp" android:layout_height="52dp" android:background="@drawable/nav_selected" android:clickable="true" android:focusable="true" android:gravity="center" android:text="⌂" android:textColor="#FFFFFF" android:textSize="24sp" />
        <TextView android:layout_width="56dp" android:layout_height="52dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="▦" android:textColor="#8D929D" android:textSize="24sp" />
        <TextView android:layout_width="56dp" android:layout_height="52dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="⚙" android:textColor="#8D929D" android:textSize="23sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="210dp" android:layout_gravity="bottom" android:layout_marginStart="92dp" android:layout_marginEnd="28dp" android:layout_marginBottom="82dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE CHANNELS" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:text="HD" android:textColor="#E53935" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="NEWS" android:textColor="#8F95A0" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="SPORTS" android:textColor="#8F95A0" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="ENTERTAINMENT" android:textColor="#8F95A0" android:textSize="12sp" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="150dp" android:scrollbars="none">
            <LinearLayout
                android:id="@+id/channelContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:layout_gravity="bottom" android:background="#F00B0D12" android:gravity="center_vertical" android:paddingStart="28dp" android:paddingEnd="28dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Khattak TV Live  •  HD Broadcast" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="64dp" android:layout_height="48dp" android:layout_marginEnd="10dp" android:background="@drawable/control_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="‹" android:textColor="#FFFFFF" android:textSize="28sp" />
        <TextView android:layout_width="64dp" android:layout_height="48dp" android:background="@drawable/control_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="▶" android:textColor="#FFFFFF" android:textSize="18sp" />
        <TextView android:layout_width="64dp" android:layout_height="48dp" android:layout_marginStart="10dp" android:background="@drawable/control_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="›" android:textColor="#FFFFFF" android:textSize="28sp" />
    </LinearLayout>
</FrameLayout>
